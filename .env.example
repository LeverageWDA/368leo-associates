# Copy to .env.local for local development. Never commit real values.
# See docs/setup.md for where each value comes from.

# Public canonical URL (no trailing slash). Used for metadata, robots and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Supabase Postgres) — server only --------------------------------
# Runtime connection as the least-privilege `leo_app` role, via the transaction
# pooler (port 6543). Required for the admin area.
DATABASE_URL=
# Schema-owner connection (session pooler, port 5432) used ONLY by
# `npm run db:migrate` and `npm run admin:provision-owner`. Keep it out of the
# deployed runtime environment.
MIGRATION_DATABASE_URL=

# --- Authentication (Clerk) ------------------------------------------------------
# Both are required to open the admin area; without them /admin returns 503.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Production only: the Clerk custom domain origin, e.g. https://clerk.<label-domain>.
CLERK_FRONTEND_API_ORIGIN=

# --- Tests only ------------------------------------------------------------------
# Superuser connection to a disposable local Postgres for integration tests.
# TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
# Use a preinstalled Chromium instead of `npx playwright install`.
# PLAYWRIGHT_CHROMIUM_PATH=
